}\n\n.warningIcon {\n  font-size: 13px;\n  color: var(--text-warning-primary);\n  &:hover {\n    color: var(--text-warning-secondary);\n  }\n}\n\n.pdfIcon {\n  display: flex;\n  border-radius: 4px;\n  height: 50px;\n  width: 50px;\n  background-color: var(--background-brand-teal-primary);\n\n  i {\n    margin: auto;\n    color: white;\n    font-size: 1.5rem;\n  }\n}\n\n.alertContainer {\n  width: 100%;\n  display: flex;\n\n  .alert {\n    flex: 1;\n  }\n}\n\n.modalActionsRow {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 8px 0 4px;\n  width: 100%;\n}\n"],sourceRoot:""}]),a.locals={loading:"abT3BzPkfuMwBgC_VLlk",starterAssetsModal:"RmpGqvYuTXdzlfHzF9Io",modalBody:"oJiRv8Xg3ZG45r12_Oa5",fileIconCard:"rNDuvTpqnvHaGHrSkdan",fileIconImageArea:"Zo4To7HYMWc2YInj6JqX",fileIconImage:"o99f9JXCdI__9SBLGBsP",checkboxOverlay:"XBlnYUtBuGh1L8HO1BqC",loadingIcon:"jRwOuotH6nRGtLYl_iUy",fileInfo:"ZFLCcogk17uvPxCVfV2A",filenameRow:"xvVcmHVQtZq3rv0z3joM",fileInfoRow:"HRy6bAd_2ckcASo4w491",filename:"SOnBqaxAcSPS8vdbk882",fileDetail:"iQK2Yukl5NNxVvF3Wovg",previewButton:"xULB1Erk3oQ1xLHoAoqD",warningIcon:"Gwlu1Z9OCL19cKMk9LsA",pdfIcon:"oewxpK5tohRxkGFa5zJT",alertContainer:"BYkA5hQjdigpSgDEOrtn",alert:"nNi9D3QEs03qbqdtwaUj",modalActionsRow:"oPOfsjAGN4CAAI3BH4yQ"};const s=a},,,(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(20),o=n.n(r),i=n(21),a=n.n(i)()(o());a.push([e.id,'.vdKIv5IKVXV_GbS0H4pP{color:var(--text-neutral-primary);margin:0 0 .5em 0;font-family:var(--font-family-barlow-semi-condensed-semibold);font-weight:var(--font-weight-semi-bold);font-size:3rem;line-height:1.16}.vdKIv5IKVXV_GbS0H4pP.yofqumXhTsKcaIlIGNHF h1,.vdKIv5IKVXV_GbS0H4pP.yofqumXhTsKcaIlIGNHF h2,.vdKIv5IKVXV_GbS0H4pP.yofqumXhTsKcaIlIGNHF h3,.vdKIv5IKVXV_GbS0H4pP.yofqumXhTsKcaIlIGNHF h4,.vdKIv5IKVXV_GbS0H4pP.yofqumXhTsKcaIlIGNHF h5,.vdKIv5IKVXV_GbS0H4pP.yofqumXhTsKcaIlIGNHF h6{color:var(--text-neutral-primary);margin:0 0 .5em 0;font-family:var(--font-family-barlow-semi-condensed-semibold);f
Y31NWfZ2Jucas{display:flex;justify-content:flex-start;align-items:center;align-self:stretch;overflow:hidden;flex:1;appearance:none;-webkit-appearance:none;background:none;border:none;padding:0;margin:0;cursor:pointer;color:inherit;font:inherit;line-height:inherit;text-align:start;min-width:0;box-sizing:border-box}.LkoFO0mY31NWfZ2Jucas i{color:var(--text-neutral-tertiary)}.s831YbTN03x3s7kpJ8e4{background-color:var(--background-neutral-tertiary)}.zn3614E2wS8QLCYsipDr{padding-block:.25rem .5rem}.gkPzn9L33zY01o8NeuTa{width:auto;min-width:100px}.ixhP7EKoYXwTtheOiAFt{color:var(--text-error-primary-fixed);font-size:1rem}.aAGhT8TmKH3kcrlar5r9{display:flex;align-items:start;gap:8px}.oTF_yL5X2EEWwO_bwwyl{color:var(--text-error-primary);font-size:1rem}._5IaF64qxtnUs_4NjQXb{background-color:var(--background-neutral-primary);border-radius:4px;box-shadow:0 4px 12px rgba(0,0,0,.1);cursor:grabbing}.LkoFO0mY31NWfZ2Jucas:focus-visible{outline:var(--borders-brand-teal-primary) solid 2px;outline-offset:-2px;border-radius:.375rem}","",{version:3,sources:["webpack://./src/codebridge/FileBrowser/styles/filebrowser.module.scss","webpack://./src/lab2/views/components/layout/variables.scss"],names:[],mappings:"AAEA,sBACE,WAAA,CACA,eAAA,CAGF,sBACE,eAAA,CACA,oFAAA,CAEA,WAAA,CACA,oDAAA,CACA,0DCVe,CDaf,0BACE,oDAAA,CAIJ,sBACE,YAAA,CACA,6BAAA,CACA,kBAAA,CACA,cAAA,CACA,cAAA,CACA,eAAA,CACA,qBAAA,CACA,iBAAA,CACA,qBAAA,CACA,8BAAA,CAEA,2CACE,oBAAA,CACA,mDAAA,CACA,mBAAA,CACA,mDAAA,CAEA,6CACE,iCAAA,CAGF,4EACE,mDAAA,CAIJ,uDACE,mDAAA,CACA,iBCzCoB,CD4CtB,4CACE,oBAAA,CACA,iBAAA,CACA,gBAAA,CACA,YAAA,CACA,iBAAA,CAEA,oDACE,qBAAA,CAON,sBACE,eAAA,CACA,SAAA,CACA,QAAA,CAIF,kEACE,wBAAA,CAEA,mHACE,4DC5Ea,CD8Eb,yHACE,yBAAA,CAIA,uIACE,yBAAA,CAOR,0EACE,YAAA,CACA,0BAAA,CACA,qBAAA,CACA,cAAA,CACA,kBAAA,CAGF,qFACE,qDAAA,CAGF,+EACE,YAAA,CACA,+BAAA,CAKF,4BACE,SAAA,CACA,WAAA,CACA,UAAA,CACA,yBAAA,CACA,oBAAA,CACA,4BAAA,CACA,eAAA,CAMA,qEAEE,SAAA,CACA,6DAAA,CAKJ,6IAGE,SAAA,CAGF,sBACE,eAAA,CACA,UAAA,CAEA,wBACE,eAAA,CACA,sBAAA,CAEA,8CACE,eAAA,CAKN,sBACE,YAAA,CACA,0BAAA,CACA,kBAAA,CACA,kBAAA,CACA,eAAA,CACA,MAAA,CAEA,eAAA,CACA,uBAAA,CACA,eAAA,CACA,WAAA,CACA,SAAA,CACA,QAAA,CACA,cAAA,CACA,aAAA,CACA,YAAA,CACA,mBAAA,CACA,gBAAA,CACA,WAAA,CACA,qBAAA,CAEA,wBACE,kCAAA,CAIJ,sBACE,mDAAA,CAGF,sBACE,0BAAA,CAGF,sBACE,UAAA,CACA,eAAA,CAGF,sBACE,qCAAA,CACA,cAAA,CAGF,sBACE,YAAA,CACA,iBAAA,CACA,OAAA,CAGF,sBACE,+BAAA,CACA,cAAA,CAIF,sBACE,kDAAA,CACA,iBC5MsB,CD6MtB,oCAAA,CACA,eAAA,CAGF,oCACE,mDAAA,CACA,mBAAA,CACA,qBAAA",sourcesContent:["@use '@cdo/apps/lab2/views/components/layout/variables.scss' as variables;\n\n.fileBrowser {\n  height: 100%;\n  overflow: hidden;\n}\n\n.fileBrowserContents {\n  overflow-y: auto;\n  scrollbar-color: var(--background-neutral-senary)\n    var(--background-neutral-secondary);\n  height: 100%;\n  background-color: var(--background-neutral-secondary);\n  border-inline-end: variables.$default-border;\n\n  // Override the background color of any child divs\n  & > div {\n    background-color: var(--background-neutral-secondary);\n  }\n}\n\n.row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  cursor: pointer;\n  font-size: 14px;\n  min-height: 24px;\n  margin-inline: 0.375rem;\n  margin-bottom: 2px;\n  padding-block: 0.125rem;\n  transition: all 0.2s ease-in-out;\n\n  &.aiTutorVersion {\n    border-radius: 0.25rem;\n    outline: 1px solid var(--borders-brand-aqua-primary);\n    outline-offset: -1px;\n    background: var(--background-brand-aqua-extra-light);\n\n    i {\n      color: var(--text-neutral-primary);\n    }\n\n    &:hover:not(.dragging) {\n      background-color: var(--background-brand-aqua-light);\n    }\n  }\n\n  &:hover:not(.dragging) {\n    background-color: var(--background-neutral-tertiary);\n    border-radius: variables.$default-border-radius;\n  }\n\n  .rowIcon {\n    margin: 0.125rem 0.5rem;\n    font-size: 0.875rem;\n    line-height: 125%;\n    width: 0.75rem;\n    text-align: center;\n\n    &::before {\n      vertical-align: middle;\n    }\n  }\n}\n\n// list-style:none removes default markers; role=\"list\" on every <ol> using this\n// class restores the VoiceOver/Safari semantics that list-style:none strips.\n.folder {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n// Adds indent and border when a folder or file is in a folder\n.fileBrowser .folder .folder {\n  padding-inline-start: 8px;\n\n  .row:not(.dragging) {\n    border-inline-start: variables.$default-border;\n\n    &:hover {\n      border-radius: 0 variables.$default-border-radius\n        variables.$default-border-radius 0;\n\n      // RTL support\n      html[dir='rtl'] & {\n        border-radius: variables.$default-border-radius 0 0\n          variables.$default-border-radius;\n      }\n    }\n  }\n}\n\n.fileBrowser .folder div span.button-bar {\n  display: flex;\n  justify-content: flex-start;\n  flex-direction: column;\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n.fileBrowser .folder div span.button-bar span:hover {\n  background-color: var(--background-neutral-quaternary);\n}\n\n.fileBrowser .folder div span.button-bar span {\n  display: grid;\n  grid-template-columns: 15px auto;\n}\n\n// Using button to increase specificity of this class\n// (this allows it to take precedence over the component library button styles)\nbutton.button-kebab {\n  opacity: 0;\n  height: 20px;\n  width: 20px;\n  min-width: 20px !important; // !important to override the default button min-width\n  margin-block: 0.125rem;\n  margin-inline: 0.125rem 0.25rem;\n  transition: none;\n\n  // We use important here because the hover, and active styles used by Button\n  // are more specific than a single class.\n  // We need a different hover color for the kebab button because it is on top of another\n  // element with the standard hover color.\n  &:hover,\n  &:active {\n    opacity: 1;\n    background-color: var(--background-neutral-quinary) !important;\n  }\n}\n\n// This allows the ellipsis to display when the row is hovered or contains focus\n.row:hover > .button-kebab,\n.row:focus-within > .button-kebab,\nbutton.button-kebab:focus {\n  opacity: 1;\n}\n\n.nameContainer {\n  overflow: hidden;\n  width: auto;\n\n  p {\n    overflow: hidden;\n    text-overflow: ellipsis;\n\n    .activeFile & {\n      font-weight: 600;\n    }\n  }\n}\n\n.label {\n  display: flex;\n  justify-content: flex-start;\n  align-items: center;\n  align-self: stretch;\n  overflow: hidden;\n  flex: 1;\n  // Button reset — ensures <button> renders identically to the old <div>\n  appearance: none;\n  -webkit-appearance: none;\n  background: none;\n  border: none;\n  padding: 0;\n  margin: 0;\n  cursor: pointer;\n  color: inherit;\n  font: inherit;\n  line-height: inherit;\n  text-align: start;\n  min-width: 0;\n  box-sizing: border-box;\n\n  i {\n    color: var(--text-neutral-tertiary);\n  }\n}\n\n.acceptingDrop {\n  background-color: var(--background-neutral-tertiary);\n}\n\n.expandedDroppableArea {\n  padding-block: 0.25rem 0.5rem;\n}\n\n.dropdownItem {\n  width: auto;\n  min-width: 100px;\n}\n\n.alertIcon {\n  color: var(--text-error-primary-fixed);\n  font-size: 1rem;\n}\n\n.backpackErrorContainer {\n  display: flex;\n  align-items: start;\n  gap: 8px;\n}\n\n.backpackErrorMessage {\n  color: var(--text-error-primary);\n  font-size: 1rem;\n}\n\n// Style applied when a file or folder is being dragged\n.dragging {\n  background-color: var(--background-neutral-primary);\n  border-radius: variables.$default-border-radius;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);\n  cursor: grabbing;\n}\n\n.label:focus-visible {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: -2px;\n  border-radius: 0.375rem;\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n"],sourceRoot:""}]),a.locals={fileBrowser:"x0szwhou8fo0ff479Ukl",fileBrowserContents:"L78pLFN4z4PE8MAh58EA",row:"LYdfkNHEr9200aBMihSI",aiTutorVersion:"VxwJ5ZWZ6Jv0mfHSLSrR",dragging:"_5IaF64qxtnUs_4NjQXb",rowIcon:"zH9d0DZwBPrVrLHe4edD",folder:"jbECaddsrNwfAcu0I7iz","button-bar":"hRZs3yrXz53qu5GpEzx1","button-kebab":"oDP8_PKlgv7PhUYTMGZs",nameContainer:"ZX7N2kUlGtlw8lvIkX5A",activeFile:"Si7WEy1gUpB2SFRqDsCs",label:"LkoFO0mY31NWfZ2Jucas",acceptingDrop:"s831YbTN03x3s7kpJ8e4",expandedDroppableArea:"zn3614E2wS8QLCYsipDr",dropdownItem:"gkPzn9L33zY01o8NeuTa",alertIcon:"ixhP7EKoYXwTtheOiAFt",backpackErrorContainer:"aAGhT8TmKH3kcrlar5r9",backpackErrorMessage:"oTF_yL5X2EEWwO_bwwyl"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(20),o=n.n(r),i=n(21),a=n.n(i)()(o());a.push([e.id,".SRwHGax2saTpkOW6vx71{display:flex;padding-block:.25rem;padding-inline:.5rem .625rem;align-items:center;gap:.375rem;align-self:stretch;transition:background-color .2s ease-in-out}.SRwHGax2saTpkOW6vx71:hover{background-color:var(--background-neutral-tertiary)}.SRwHGax2saTpkOW6vx71 i{color:var(--text-neutral-primary);text-align:center;width:1rem}","",{version:3,sources:["webpack://./src/codebridge/styles/dropdown.module.scss"],names:[],mappings:"AAAA,sBACE,YAAA,CACA,oBAAA,CACA,4BAAA,CACA,kBAAA,CACA,WAAA,CACA,kBAAA,CACA,2CAAA,CAEA,4BACE,mDAAA,CAGF,wBACE,iCAAA,CACA,iBAAA,CACA,UAAA",sourcesContent:[".dropdownItem {\n  display: flex;\n  padding-block: 0.25rem;\n  padding-inline: 0.5rem 0.625rem;\n  align-items: center;\n  gap: 0.375rem;\n  align-self: stretch;\n  transition: background-color 0.2s ease-in-out;\n\n  &:hover {\n    background-color: var(--background-neutral-tertiary);\n  }\n\n  i {\n    color: var(--text-neutral-primar
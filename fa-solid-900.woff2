Cc,CD0Cd,mBAAA,CACA,WAAA,CAEA,qEACE,eAAA,CAGF,sFACE,UAAA,CAGF,sFACE,uCAAA,CAGF,sFACE,uCAAA,CAGF,sFACE,oCAAA,CAGF,sFACE,4CAAA,CAGF,sFACE,qCAAA,CAGF,sFACE,uCAAA,CA3EA,mMAEE,gDAAA,CACA,sDAAA,CAHF,mMAEE,gDAAA,CACA,sDAAA,CAHF,mMAEE,6CAAA,CACA,mDAAA,CAHF,mMAEE,qDAAA,CACA,2DAAA,CAHF,mMAEE,8CAAA,CACA,oDAAA,CAHF,mMAEE,gDAAA,CACA,sDAAA,CAyFF,2EACE,kCAAA",sourcesContent:["@use '@cdo/apps/lab2/views/components/layout/variables.scss' as variables;\n\n// Generate hover and active states for each button based on icon type\n@mixin generate-chat-button-hover-states($icon-color-map) {\n  @each $icon, $color in $icon-color-map {\n    &:hover:has(.icon-#{$icon}),\n    &:active:has(.icon-#{$icon}) {\n      background: var(--background-#{$color}-extra-light);\n      border-color: var(--borders-#{$color}-primary) !important;\n    }\n  }\n}\n\n@keyframes fade-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n.container {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n\n  .userMessageContainer {\n    margin-top: auto;\n  }\n}\n\n.loading {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  width: 100%;\n  height: 100%;\n  background-color: var(--background-neutral-primary);\n  animation: fade-in 2s ease-in forwards;\n}\n\n/* Multiple classes used to increase specifity to override default DSCO styles */\n.chatButton.chatButton.chatButton {\n  padding: 0.25rem 0.625rem;\n  border: variables.$strong-border;\n  border-radius: 50rem;\n  gap: 0.375rem;\n\n  span {\n    font-weight: 400;\n  }\n\n  .icon {\n    width: auto;\n  }\n\n  .icon-code {\n    color: var(--text-success-primary-fixed);\n  }\n\n  .icon-lightbulb {\n    color: var(--text-warning-primary-fixed);\n  }\n\n  .icon-book {\n    color: var(--text-info-primary-fixed);\n  }\n\n  .icon-brain {\n    color: var(--text-brand-purple-primary-fixed);\n  }\n\n  .icon-bug {\n    color: var(--text-error-primary-fixed);\n  }\n\n  .icon-star {\n    color: var(--text-warning-primary-fixed);\n  }\n\n  // Hover and active states\n  @include generate-chat-button-hover-states(\n    (\n      'code': 'success',\n      'lightbulb': 'warning',\n      'book': 'info',\n      'brain': 'brand-purple',\n      'bug': 'error',\n      'star': 'warning',\n    )\n  );\n\n  // Disabled state\n  &:disabled {\n    i {\n      color: var(--text-neutral-disabled);\n    }\n  }\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n"],sourceRoot:""}]),a.locals={container:"yBFjYHzxLa6ucbLY4CLA",userMessageContainer:"BEFYEezxNPzXRgoCzeAr",loading:"Ln4HrX5ev50i6Bu9xy6G","fade-in":"CbCdU6ZHQC8EH30iJAMN",chatButton:"kzpDZT7uR1XcwKpzL8Vj",icon:"y9VgXe3w_vKbfIB8gegA","icon-code":"F5dnAOQSt6KV4pLzi1dd","icon-lightbulb":"cfAgw_5f_cWNETwBQEu9","icon-book":"UKBMRFJ26oRYRFXgctoW","icon-brain":"SEz_Jel2KTQVKlMPecCr","icon-bug":"soyAWap157g95XtwbtY1","icon-star":"kvr2o44HE2L7MFTUZUiJ"};const s=a},,,(e,t)=>{"use strict";Object.defineProperty(t,"__esModule",{value:!0}),t.extractUserInput=void 0;t.extractUserInput=function(e,t){var n=e.type,r=e.args;return"confirm"===n||"neutral"===n&&t?r:""}},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(20),o=n.n(r),i=n(21),a=n.n(i)()(o());a.push([e.id,".uYItL77TWcU0wtVbhTfw{height:45px}.hzi4zAQLtOeALKbcN1HF{padding:10px;border:1px solid gray;font-size:14px;max-width:350px;overflow:hidden}.hzi4zAQLtOeALKbcN1HF.pEv7nG0FjvBfyWDiVoGw{background-color:#d9f3f5}.hzi4zAQLtOeALKbcN1HF.QFx0DJcXsN
ACA,CAAA,QACA,CAAA,YACA,CAAA,kCACA,CAAA,iCACA,CAAA,eGzhCc,CAAA,kDH2hCd,CAAA,YACA,CAAA,iBACA,CAAA,iBACA,CAAA,iCAEA,+BACE,CAAA,mCACA,CAAA,yBAGF,eACE,CAAA,sBAIJ,6BACE,CAAA,wBACA,CAAA,sBAGF,WACE,CAAA,sBAGF,kBACE,CAAA,6BACA,CAAA,kBACA,CAAA,kBACA,CAAA,YACA,CAAA,sBAGF,YACE,CAAA,sBACA,CAAA,kBACA,CAAA,sBAGF,YACE,CAAA,QACA,CAAA,sBAGF,YACE,CAAA,sBACA,CAAA,kBACA,CAAA,QACA,CAAA,4BAGF,eACE,CAAA,8BACA,CAAA,qEAEA,eAEE,CAAA,sBAIJ,YACE,CAAA,qBACA,CAAA,kBACA,CAAA,sBAGF,YACE,CAAA,qBACA,CAAA,QACA,CAAA,UACA,CAAA,sBAGF,YACE,CAAA,qBACA,CAAA,kBACA,CAAA,6BACA,CAAA,kBACA,CAAA,iBACA,CAAA,wBACA,CAAA,kBG1mCc,CAAA,QH4mCd,CAAA,YACA,CAAA,wBAEA,eACE,CAAA,sBAIJ,iBACE,CAAA,sBAGF,YACE,CAAA,qBACA,CAAA,kBACA,CAAA,sBAGF,cACE,CAAA,QACA,CAAA,uBAGF,cACE,CAAA,uBACA,CAAA,uBAGF,YACE,CAAA,sBAGF,YACE,CAAA,qBACA,CAAA,6BACA,CAAA,sBAGF,+CAEE,CAAA,sBACA,CAAA,eACA,CAAA,gBACA,CAAA,4BACA,CAAA,QACA,CAAA,oBACA,CAAA,aACA,CAAA,eACA,CAAA,WACA,CAAA,YAEA,CAAA,kBACA,CAAA,cACA,CAAA,+BACA,CAAA,qBAEA,CAAA,QACA,CAAA,2BAEA,mCEvyCA,CAAA,sCACA,CAAA,iBACA,CAAA,iCD8EA,CAAA,iBACA,CAAA,kCAiBA,CAAA,gBACA,CAAA,aDssCE,CAAA,eACA,CAAA,eACA,CAAA,sBACA,CAAA,6BAGF,mBACE,CAAA,4BAGF,+BACE,CAAA,oBACA,CAAA,eACA,CAAA,0BAKF,yBACE,CAAA,+BACA,iBACE,CAAA,4BAIJ,mCACE,CAAA,6BAGF,mCACE,CAAA,kCACA,wBACE,CAAA,sBAKN,kBACE,CAAA,cACA,CAAA,WACA,CAAA,eACA,CAAA,cACA,CAAA,cACA,CAAA,YACA,CAAA,kBACA,CAAA,sBAGF,wBG/qCwB,CAAA,sBHmrCxB,wBGh1CiB,CAAA,sBHo1CjB,qDACE,CAAA,sBAGF,wBGvrCqB,CAAA,sBH2rCrB,wBG1sCiB,CAAA,sBH8sCjB,qBACE,CAAA,YACA,CAAA,kBACA,CAAA,iBACA,CAAA,eACA,CAAA,WACA,CAAA,yBAEA,mBACE,CAAA,sBAIJ,0BACE,CAAA,yBACA,CAAA,YACA,CAAA,kBACA,CAAA,sBACA,CAAA,qCAGF,sBACE,oBACE,CAAA,CAAA,sBAIJ,eACE,CAAA,kBACA,CAAA,eACA,CAAA,gBACA,CAAA,iBACA,CAAA,sBAGF,eACE",sourcesContent:["@use '@code-dot-org/component-library-styles/typography.module.scss' as\n  typography;\n@import 'color';\n@import '@code-dot-org/component-library-styles/font';\n@import '@code-dot-org/component-library-styles/mixins';\n\n@keyframes pulse {\n  0% {\n    transform: scale(0.9);\n  }\n  70% {\n    transform: scale(1);\n    box-shadow: 0 0 0 50px rgba(90 153 212 / 0);\n  }\n  100% {\n    transform: scale(0.9);\n    box-shadow: 0 0 0 0 rgba(90 153 212 / 0);\n  }\n}\n\n.floatingActionButton {\n  position: fixed;\n  left: 10px;\n  bottom: 48px;\n\n  height: 55px;\n  width: 55px;\n  background-size: 55px;\n  padding: 0;\n\n  border-width: 0;\n  border-radius: 30px;\n\n  img {\n    opacity: 1;\n    border-radius: 30px;\n  }\n}\n\n.pulse {\n  animation: pulse 1.5s 1.7;\n  box-shadow: 0 0 0 0 rgba(90 153 212 / 0.5);\n}\n\n.taOverlay {\n  position: fixed;\n  left: 51px;\n  bottom: 97px;\n\n  height: 18px;\n  width: 28px;\n  background-size: 28px;\n  padding: 0;\n\n  border-width: 2px;\n  border-color: $background_gray;\n  border-radius: 15px;\n  border-style: solid;\n}\n\n.countOverlay {\n  position: fixed;\n  left: 51px;\n  bottom: 97px;\n\n  border-radius: 100px;\n  border-width: 2px;\n  border-color: $background_gray;\n  border-style: solid;\n\n  display: inline-flex;\n  height: 18px;\n  min-width: 18px;\n  padding: 2px 2px;\n  justify-content: center;\n  align-items: center;\n  flex-shrink: 0;\n\n  background: var(--sentiment-error-50, #e5311a);\n}\n\np.countText {\n  margin-top: 1px;\n  margin-bottom: 0 !important;\n  padding: 0 2px;\n\n  strong {\n    span {\n      color: var(--text-neutral-white-fixed, #fff);\n    }\n  }\n  font-variant-ligatures: no-common-ligatures;\n}\n\n.dismissableAlert {\n  position: fixed;\n  left: 86px;\n  bottom: 55px;\n  z-index: 2000;\n\n  display: flex;\n  width: 300px;\n  max-width: 300px;\n  padding: 12px;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 20px;\n\n  border-radius: 4px;\n  border: 1px solid var(--neutral-gray-20, #d1d4d8);\n  background: var(--neutral-base-white, #fff);\n\n  box-shadow: 0 4px 4px 0 rgb(0 0 0 / 0.25);\n}\n\n.dismissableAlertText {\n  max-width: 266px;\n  margin-top: 4px;\n  margin-left: 4px;\n  margin-bottom: -24px;\n\n  color: var(--text-neutral-primary, #292f36);\n  font-variant-ligatures: no-common-ligatures;\n}\n\n.viewScoresButton {\n  min-height: 35px;\n  width: 286px;\n\n  display: flex;\n  padding: 5px 16px;\n  justify-content: center;\n  align-items: center;\n  gap: 8px;\n  flex: 1 0 0;\n\n  border-radius: 4px;\n  background: var(--brand-aqua-50, #3cfff7) !important;\n}\n\n.viewScoresText {\n  color: var(--light-black, #292f36);\n  font-variant-ligatures: no-common-ligatures;\n\n  /* Button/Button 3 */\n  font-family: Figtree, sans-serif;\n  font-size: 14px;\n  font-style: normal;\n  font-weight: 600;\n  line-height: 154%; /* 21.56px */\n}\n\n.rubricContainer {\n  position: fixed;\n  left: 10px;\n  bottom: 123px;\n  z-index: 2000;\n  width: 760px;\n}\n\n.settings {\n  width: 724px;\n  min-height: 298px;\n  padding: 16px 16px 32px 16px;\n  gap: 16px;\n\n  border-radius: 0 0 4px 4px;\n  border-right: 2px solid $neutral_dark;\n  border-bottom: 2px solid $neutral_dark;\n  border-left: 2px solid $neutral_dark;\n  background: $neutral_light;\n  box-shadow: 4px 4px 6px 0 rgb(0 0 0 / 0.25);\n\n  h2 {\n    margin-bottom: 0;\n  }\n}\n\n.settingsVisible {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n}\n\n.settingsHidden {\n  display: none;\n}\n\n.aiAssessmentOptions {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 1rem;\n  align-self: stretch;\n  border-bottom: 1px solid $light_gray_200;\n  padding-bottom: 1rem;\n\n  p {\n    margin-bottom: 0;\n  }\n}\n\n.rubricContent {\n  border-right: 2px solid $neutral_dark;\n  border-left: 2px solid $neutral_dark;\n  background: $neutral_light;\n  box-shadow: 0.25rem 0.25rem 0.375rem 0 rgba(0 0 0 / 0.25);\n  height: 408px;\n  overflow-x: hidden;\n  overflow-y: auto;\n  padding: 16px;\n\n  &:last-child {\n    border-radius: 0 0 4px 4px;\n    border-bottom: 2px solid $neutral_dark;\n  }\n}\n\n.visibleRubricContent {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 28px;\n}\n\n.hiddenRubricContent {\n  display: none;\n}\n\n.rubricFooter {\n  background: $neutral_dark;\n  border-radius: 0 0 4px 4px;\n  border-bottom: 2px solid $neutral_dark;\n  color: $neutral_white;\n  display: flex;\n  flex-direction: row;\n  gap: 0.5rem;\n  padding: 0.5rem 2rem 0.5rem 1rem;\n}\n\n.rubricFooterContent {\n  flex: 1 1 100%;\n  padding: 0.25rem 0;\n\n  input[type='checkbox'] {\n    & + i::before {\n      background: $neutral_white;\n    }\n\n    & ~ span {\n      color: $neutral_white;\n    }\n  }\n}\n\n.submitToStudentButtonAndError {\n  display: flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 0.25rem;\n  align-self: stretch;\n\n  p {\n    color: $neutral_white;\n    line-height: 0.75rem;\n    margin: 0;\n    min-height: 0.75rem;\n    position: relative;\n    top: 0.1875rem;\n    font-size: 0.6875rem;\n  }\n}\n\n.rubricContainerFooter {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n  align-self: stretch;\n}\n\n.submitToStudentButton {\n  margin: 0;\n}\n\n.studentInfo {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 1rem;\n  align-self: stretch;\n\n  h2 {\n    margin-bottom: 0;\n  }\n}\n\n.studentMetadata {\n  display: flex;\n  align-items: flex-start;\n  gap: 1.5rem;\n  align-self: stretch;\n  justify-content: center;\n}\n\n.levelAndStudentDetails {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.5rem;\n  align-self: stretch;\n\n  h5,\n  p {\n    margin-bottom: 0;\n  }\n}\n\n.singleMetadatum {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.rubricHeader {\n  border-radius: 4px 4px 0 0;\n  background: $neutral_dark;\n  color: $neutral_white;\n  // padding: 9px 15px 8px;\n\n  border-top: 2px solid $neutral_dark;\n  border-right: 2px solid $neutral_dark;\n  border-left: 2px solid $neutral_dark;\n\n  display: flex;\n  height: 40px;\n  justify-content: space-between;\n  align-items: center;\n  align-self: stretch;\n}\n\n.rubricHeaderRedesign {\n  border-radius: 4px 4px 0 0;\n  background: $neutral_dark;\n  color: $neutral_white;\n  // padding: 9px 15px 8px;\n\n  border-top: 2px solid $neutral_dark;\n  border-right: 2px solid $neutral_dark;\n  border-left: 2px solid $neutral_dark;\n\n  padding-inline-start: 0.75rem;\n\n  display: flex;\n  height: 40px;\n  justify-content: space-between;\n  align-items: center;\n  align-self: stretch;\n}\n\n.rubricHeaderLeftSide {\n  display: flex;\n  gap: 0.25rem;\n  align-items: center;\n\n  .aiBotOutlineIcon {\n    width: 1.5rem;\n    height: 1.5rem;\n  }\n\n  span {\n    @include label-two;\n    margin: 0;\n  }\n}\n\n.rubricHeaderRightSide {\n  display: flex;\n  align-items: flex-start;\n  align-self: stretch;\n}\n\nbutton.buttonStyle {\n  border-width: 0;\n  margin: 0;\n\n  &:hover {\n    box-shadow: none;\n  }\n}\n\n.closeButton {\n  display: flex;\n  padding: 11px 16px;\n  justify-content: center;\n  align-items: center;\n  gap: 10px;\n  align-self: stretch;\n  background-color: $neutral_dark;\n  color: $neutral_white;\n}\n\nbutton.rubricHeaderTab {\n  display: flex;\n  height: 40px;\n  padding: 0 16px;\n  align-items: center;\n  border-radius: 4px 4px 0 0;\n}\n\n.selectedTab {\n  background: $neutral_light;\n  h6 {\n    line-height: 1.1875;\n    margin-bottom: 0;\n    color: $light_primary_700;\n  }\n}\n\n.unselectedTab {\n  background: $neutral_dark70;\n  h6 {\n    color: $neutral_white;\n    margin-bottom: 0;\n    line-height: 1.1875;\n  }\n}\n\n.learningGoalContainer {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: space-between;\n  align-self: stretch;\n  border-radius: 4px;\n  border: 1px solid $neutral_dark40;\n  background: $neutral_white;\n}\n\n.learningGoalRow {\n  display: flex;\n  align-self: stretch;\n  border-bottom: 1px solid $neutral_dark40;\n  min-height: 40px;\n\n  // Directly target the <summary> child with the class\n  .learningGoalHeader {\n    display: flex;\n    height: 40px;\n    padding: 0 1rem 0 2rem;\n    justify-content: space-between;\n    align-items: flex-start;\n    align-self: stretch;\n    line-height: 154%;\n    position: relative;\n\n    // Common styles for the FontAwesome icons, regardless of state\n    &::after {\n      font: var(--fa-font-solid);\n      position: absolute;\n      left: 1rem;\n      top: 50%;\n      transform: translateY(-35%);\n      padding-right: 10px;\n      height: 16px;\n      width: 16px;\n      // Icon for closed details\n      content: '\\f107';\n    }\n\n    &:hover {\n      background: none;\n      cursor: pointer;\n    }\n\n    // Hide the default disclosure arrow for summary elements in Safari\n    &::-webkit-details-marker {\n      display: none;\n    }\n  }\n\n  // When the details are open, change the icon\n  &[open] .learningGoalHeader::after {\n    content: '\\f106';\n  }\n}\n\n.learningGoalHeaderLeftSide {\n  @include main-font-semi-bold;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  font-size: 14px;\n  padding-left: 10px;\n  padding-top: 0.5rem;\n}\n\n.learningGoalHeaderRightSide {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n  gap: 16px;\n  font-weight: 325;\n  line-height: 154%;\n\n  p {\n    margin-bottom: 0;\n  }\n}\n\np.feedbackIndicatorText {\n  margin-bottom: 0;\n}\n\nh2.studentName {\n  margin-bottom: 8px;\n}\n\n.submittedEvaluation {\n  display: flex;\n  width: 170px;\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.learningGoalOuterBlock {\n  align-self: stretch;\n}\n\n.learningGoalExpanded {\n  padding: 1rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  align-self: stretch;\n\n  .tipsDetailsSummary {\n    font-size: 0.875rem;\n    margin-top: 20px;\n\n    &:hover {\n      background-color: unset;\n    }\n  }\n}\n\n.learningGoalTips {\n  display: none;\n  padding: 0.5rem;\n  border-radius: 0.25rem;\n  border: 1px solid $neutral_dark50;\n  background: $neutral_dark10;\n\n  // This is body three styles but the typography components don't work well with markdown support\n  // SafeMarkdown also wraps everything in its own div so explicitly apply this style to the div\n  div {\n    @include main-font-regular;\n    color: $neutral-dark;\n    font-size: 0.875rem;\n    line-height: 1.54;\n  }\n}\n\n.evidenceLevelSetHorizontal {\n  display: flex;\n  flex-direction: row;\n  width: 100%;\n  gap: 8px;\n  min-height: 92px;\n}\n\n.evidenceLevelInnerDiv:first-child {\n  padding: 1em;\n  width: 100%;\n  border-left: 0;\n}\n\n.evidenceLevelInnerDiv {\n  padding: 1em;\n  border-left: 1px solid #a9acaf;\n  width: 100%;\n}\n\n.evidenceLevelSet {\n  display: flex;\n  align-items: flex-start;\n  flex-direction: column;\n  gap: 0.5rem;\n  align-self: stretch;\n  flex: 1;\n\n  h6 {\n    margin-bottom: 0;\n  }\n}\n\n.evidenceLevelOption {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  align-self: stretch;\n\n  span {\n    @include main-font-semi-bold;\n    font-size: 0.875rem;\n    line-height: 154%;\n  }\n\n  p,\n  h6 {\n    margin-bottom: 0;\n  }\n}\n\n.evidenceLevelLabel {\n  @include main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 154%;\n  margin-bottom: 0;\n}\n\n.evidenceLevelDescriptionIndented {\n  padding-left: 2rem;\n}\n\n.submittedEvaluationEvidenceLevel {\n  border-radius: 4px;\n  background: $light_primary_100;\n  height: 100%;\n}\n\n.studentLearningGoalContainer {\n  margin: 20px;\n}\n\np.errorMessage {\n  color: $product_negative_default;\n  margin-bottom: 0;\n}\n\n.infoTipIcon {\n  cursor: pointer;\n  margin-left: 5px;\n  margin-right: 5px;\n  font-size: 0.75rem;\n  vertical-align: middle;\n  color: gray;\n}\n\n.infoTipText {\n  max-width: 500px;\n}\n\n.openedAiAssessment {\n  padding: 1rem 1rem 0 1rem;\n}\n\n.aiAssessmentOuterBlock {\n  padding: 0.75rem 0.75rem 1rem 1.25rem;\n  border-radius: 0.25rem;\n  border: 1px solid $neutral_dark20;\n  background: $neutral_white;\n  position: relative;\n}\n\n.aiAssessmentArrow {\n  position: absolute;\n  top: calc(-0.5rem * sqrt(2) + 0.125rem);\n  left: calc(50% - 0.5rem);\n  width: 1rem;\n  height: 1rem;\n  background: $neutral_white;\n  transform: rotate(45deg);\n  border-top: 1px solid $neutral_dark20;\n  border-left: 1px solid $neutral_dark20;\n}\n\n.aiAssessmentBlock {\n  align-items: flex-start;\n  display: flex;\n  gap: 16px;\n  position: relative;\n}\n\n.aiAssessmentInfoBlock {\n  display: flex;\n  flex-direction: column;\n  align-self: stretch;\n  gap: 1rem;\n}\n\n.aiAssessmentInfoRow {\n  display: flex;\n  flex-direction: row;\n  align-self: stretch;\n  gap: 0.5rem;\n\n  p {\n    margin: 0;\n  }\n}\n\np.aiAssessmentScoreText {\n  strong::after {\n    content: ' ';\n  }\n  max-width: 280px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\np.aiAssessmentEvidenceBlock {\n  margin: 0;\n\n  + ul li p {\n    margin: 0;\n  }\n}\n\n.aiConfidenceBox {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n\n  > div:first-child {\n    display: flex;\n    flex-direction: row;\n    gap: 0.25rem;\n    margin-top: 0.375rem;\n  }\n}\n\n.aiConfidenceBoxText {\n  p.labelThree {\n    @include label-three;\n    white-space: nowrap;\n    margin: 0;\n  }\n}\n\n.aiConfidenceBar {\n  display: inline-block;\n  width: 3.25rem;\n  height: 0.5rem;\n  border-radius: 0.25rem;\n  background: $light_gray_200;\n  margin: 0;\n}\n\n.aiConfidenceBarLow {\n  &:first-child {\n    background: $light_negative_500;\n  }\n}\n\n.aiConfidenceBarMedium {\n  &:not(:last-child) {\n    background: $light_caution_500;\n  }\n}\n\n.aiConfidenceBarHigh {\n  background: $light_affirmative_500;\n}\n\n.aiAssessmentFeedback {\n  border-top: 1px solid $light_gray_200;\n  border-bottom: 1px solid $light_gray_200;\n  padding: 1rem 0;\n\n  label {\n    margin: 0 0 1rem;\n  }\n}\n\n.aiBotImg {\n  width: 4rem;\n}\n\n.inputTextbox {\n  width: 100%;\n  box-sizing: border-box;\n  height: 2.375rem;\n  min-height: 2.375rem;\n  padding: 0.5rem 0.625rem;\n  border-radius: 0.25rem;\n  border: 1px solid $light_black;\n  color: $light_black;\n  resize: vertical;\n  overflow: auto;\n}\n\n.autosaveMessage {\n  float: right;\n  line-height: 100%;\n  padding: 0;\n  color: #3ea33e;\n}\n\n.feedbackArea {\n  flex: 1;\n}\n\n.infoAlert {\n  display: flex;\n  padding: 4px 12px;\n  gap: 10px;\n  align-items: center;\n  align-self: stretch;\n  justify-content: space-between;\n  border-radius: 4px;\n  background: $light_info_100;\n\n  &:last-child {\n    margin-bottom: 24px;\n  }\n\n  p {\n    margin: 0;\n    line-height: 1.25;\n  }\n}\n\ni.infoAlertIcon {\n  color: $light-info-500;\n  font-size: 16px;\n  font-style: normal;\n  font-weight: 900;\n  line-height: 125%;\n}\n\n.infoAlertClosed {\n  display: none;\n}\n\n.aiFeedbackRadioBox {\n  display: flex;\n  flex-direction: column;\n  padding: 0 0.5rem;\n  gap: 0.125rem;\n}\n\np.aiFeedbackRadioBoxText {\n  @include label-three;\n  margin: 0;\n  white-space: nowrap;\n}\n\n.aiFeedbackRadioRow {\n  display: flex;\n  flex-direction: row;\n  align-self: center;\n  gap: 1rem;\n\n  > label {\n    margin: 0;\n  }\n}\n\n.aiFeedbackRadioLabelChecked {\n  background-color: $light_gray_100;\n  color: $light_gray_800;\n}\n\n.aiFeedbackRadioLabel {\n  display: flex;\n  padding: 4px;\n  font-size: 16px;\n  vertical-align: middle;\n  border-radius: 0.25rem;\n\n  &:hover {\n    background-color: $light_gray_100;\n    color: $light_gray_800;\n  }\n}\n\n.aiFeedbackRadio {\n  opacity: 0;\n  position: absolute;\n  height: 0;\n}\n\n.aiFeedbackOther {\n  display: flex;\n  flex-direction: column;\n  padding-top: 10px;\n  gap: 5px;\n}\n\n.aiFeedbackTextbox {\n  height: 2.375rem;\n  min-height: 2.375rem;\n  padding: 0.5rem 0.625rem;\n  width: 100%;\n  max-width: 100%;\n  resize: vertical;\n  overflow: auto;\n  box-sizing: border-box;\n  border-radius: 0.25rem;\n  border: 1px solid $light_black;\n  color: $light_black;\n}\n\n.submitFeedbackRow {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.5rem;\n}\n\n.submitFeedbackButtons {\n  display: flex;\n  gap: 0.5rem;\n}\n\nem.aiFeedbackReceived {\n  i {\n    margin-right: 0.5rem;\n  }\n}\n\n.selectors {\n  display: flex;\n  flex-direction: row;\n  justify-content: center;\n  align-items: flex-start;\n  align-self: stretch;\n  gap: 15px;\n}\n\n.studentInfoGroup {\n  display: flex;\n  align-self: center;\n  justify-content: space-around;\n  flex-direction: column;\n  text-align: center;\n  gap: 0.75rem;\n\n  h3 {\n    margin: 0;\n  }\n}\n\n.learningGoalsWrapper {\n  width: 100%;\n}\n\n.studentSelector {\n  width: 300px;\n}\n\n.learningGoalsContainer {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: space-between;\n  align-self: stretch;\n  border-radius: 4px;\n  border: 1px solid $neutral_dark20;\n  background: $neutral_light;\n  width: auto;\n}\n\n.learningGoalRing {\n  flex: 0 0 auto;\n}\n\nbutton.learningGoalButton {\n  align-self: center;\n  background: none;\n  border: none;\n  box-shadow: none;\n  flex: 0 0 auto;\n  margin: 0;\n  padding: 0.5rem;\n\n  &:active,\n  &:hover {\n    box-shadow: none;\n    // The important is needed here to override the common button:active style\n    border: none !important;\n  }\n}\n\nbutton.learningGoalButtonLeft {\n  margin-left: 0.5rem;\n  margin-right: 0.625rem;\n}\n\nbutton.learningGoalButtonRight {\n  margin-left: 0.625rem;\n  margin-right: 0.5rem;\n}\n\n.learningGoalsHeader {\n  display: flex;\n  flex-direction: row;\n  min-height: 60px;\n  justify-content: space-between;\n  align-self: stretch;\n  line-height: 154%;\n  position: relative;\n  margin: 1rem 0 0 0;\n  padding: 0 0 0.75rem 0;\n  border-bottom: 1px $light_gray_100 solid;\n  overflow: hidden;\n}\n\n.learningGoalsHeaderLeftSide {\n  @include main-font-semi-bold;\n  display: flex;\n  justify-content: flex-start;\n  align-items: center;\n  font-size: 14px;\n  flex: 1;\n  overflow: hidden;\n}\n\n.learningGoalsHeaderRightSideV2 {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n  align-self: stretch;\n  gap: 16px;\n  font-weight: 325;\n  flex: 0 0 auto;\n}\n\n.learningGoalsHeaderText {\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-start;\n  padding: 0 0.5rem;\n  flex: 0 1 100%;\n  overflow: hidden;\n}\n\np.learningGoalsHeaderTextBody,\nh5.learningGoalsHeaderTextBody {\n  white-space: nowrap;\n  text-overflow: ellipsis;\n  overflow: hidden;\n  flex: 1;\n  margin: 0;\n}\n\nh5.learningGoalsHeaderTextBody {\n  margin: 0 0 0.25rem;\n  display: flex;\n  flex-direction: row;\n\n  span {\n    align-self: stretch;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    overflow: hidden;\n  }\n}\n\n.learningGoalSummary {\n  display: flex;\n  flex-direction: row;\n  padding-left: 20px;\n  padding-right: 20px;\n  justify-content: space-between;\n  border-bottom: 1px $light_gray_100 solid;\n  margin: 1rem 1rem 0 1rem;\n}\n\n.aiTokenContainer {\n  align-self: start;\n  margin-left: 0.5rem;\n}\n\n.aiToken {\n  display: flex;\n  height: 20px;\n  padding: 2px 12px 2px 12px;\n  justify-content: center;\n  align-items: center;\n  gap: 4px;\n  white-space: nowrap;\n  border-radius: 30px;\n  background: $ai_rubric_cyan;\n}\n\np.aiTokenText {\n  color: $light_black;\n  font-size: 0.7rem;\n  line-height: 1rem;\n  margin-bottom: 0;\n}\n\n.progressRing {\n  transition: stroke-dashoffset 0.35s;\n  transform: rotate(-90deg);\n  transform-origin: 50% 50%;\n}\n\n.progressRingText {\n  text-anchor: middle;\n  font-size: smaller;\n}\n\n.learningGoalsTips {\n  padding: 0.5rem;\n  border-radius: 0.25rem;\n  border: 1px solid $neutral_dark20;\n  background: $neutral_white;\n}\n\np.evidenceLevelHeaderText {\n  margin: 0 0 0.25rem;\n}\n\n.evidenceLevelSetHorizontalV2 {\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  width: 100%;\n  gap: 8px;\n\n  p {\n    margin-bottom: 0;\n  }\n}\n\n.evidenceLevelOptionV2 {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-start;\n  align-self: stretch;\n}\n\n.evidenceLevelLabelV2 {\n  @include main-font-semi-bold;\n  font-size: 0.875rem;\n  line-height: 154%;\n  margin-bottom: 0;\n}\n\n.evidenceLevel {\n  border-radius: 100px;\n  border-width: 1px;\n  border-style: solid;\n  margin: 0;\n  padding: 0 16px 0;\n  font-size: 0.875rem;\n  height: 32px;\n  text-align: center;\n}\n\n.evidenceLevelUnselected {\n  border-color: $light_black;\n  background: $neutral_white;\n\n  &:hover {\n    box-shadow: none;\n    background-color: $light_gray_100;\n  }\n\n  &:disabled {\n    border-color: $light_black;\n    background: $neutral_white;\n  }\n}\n\n.evidenceLevelSelected {\n  border-color: $light_primary_500;\n  background: $light_primary_500;\n  color: $light_white;\n\n  &:hover {\n    box-shadow: none;\n    background-color: $light_primary_700;\n  }\n\n  &:disabled {\n    border-color: $light_primary_500;\n    background: $light_primary_500;\n    color: $light_white;\n  }\n}\n\n.evidenceLevelSuggested {\n  border-radius: 100px;\n  border: 1px solid $light_black;\n  background: $neutral_white;\n  gap: 10px;\n  font-size: 0.875rem;\n  height: 32px;\n  box-shadow: 0 0 0 0.125rem $ai_rubric_cyan;\n\n  &:hover {\n    box-shadow: 0 0 0 0.125rem $ai_rubric_cyan;\n    background-color: $light_gray_100;\n  }\n\n  &:disabled {\n    border-radius: 100px;\n    border: 1px solid $light_black;\n    background: $neutral_white;\n    gap: 10px;\n    padding: 3px 16px 0;\n    font-size: 0.875rem;\n    height: 32px;\n    box-shadow: 0 0 0 0.125rem $ai_rubric_cyan;\n  }\n}\n\n.fabBackground {\n  display: flex;\n  flex-direction: column;\n  gap: 28px;\n  padding: 1rem;\n  border-right: 0.125rem solid $neutral_dark;\n  border-left: 0.125rem solid $neutral_dark;\n  background: $neutral_white;\n  box-shadow: 0.25rem 0.25rem 0.375rem 0 rgba(0 0 0 / 0.25);\n  height: 408px;\n  overflow-x: hidden;\n  overflow-y: scroll;\n\n  &:last-child {\n    border-radius: 0 0 0.25rem 0.25rem;\n    border-bottom: 0.125rem solid $neutral_dark;\n  }\n\n  h2 {\n    margin-bottom: 0;\n  }\n}\n\n.fabErrorBackground {\n  background: $bootstrap_error_background !important;\n  color: $bootstrap_error_text !important;\n}\n\n.sectionSelector {\n  width: 180px;\n}\n\n.rubricTabGroup {\n  padding-bottom: 8px;\n  justify-content: space-between;\n  align-items: center;\n  align-self: stretch;\n  display: flex;\n}\n\n.rubricTabGroupRight {\n  display: flex;\n  align-items: flex-start;\n  align-self: stretch;\n}\n\n.infoAlertLeft {\n  display: flex;\n  gap: 10px;\n}\n\n.infoAlertRight {\n  display: flex;\n  align-items: flex-start;\n  align-self: stretch;\n  margin: 0;\n}\n\nbutton.infoAlertRight {\n  box-shadow: none;\n  border: 1px solid transparent;\n\n  &:active,\n  &:hover {\n    box-shadow: none;\n  }\n}\n\n.settingsGroup {\n  display: flex;\n  flex-direction: column;\n  align-self: stretch;\n}\n\n.settingsContent {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  width: 100%;\n}\n\n.settingsContainers {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: space-between;\n  align-self: stretch;\n  border-radius: 4px;\n  border: 1px solid $neutral_dark20;\n  background: $neutral_light;\n  gap: 15px;\n  padding: 20px;\n\n  p {\n    margin-bottom: 0;\n  }\n}\n\n.aiSettingsContainer {\n  align-items: unset;\n}\n\n.runAiAllStatuses {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.detailsGroup {\n  display: inline;\n  gap: 1rem;\n}\n\np.detailsVisible {\n  display: inline;\n  padding-inline-end: 1rem;\n}\n\np.detailsHidden {\n  display: none;\n}\n\n.studentDropdownOptionContainer {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.dropdownOption {\n  /* Reset's every elements apperance */\n  background: none repeat scroll 0 0 transparent;\n  border: none !important;\n  border-radius: 0;\n  border-spacing: 0;\n  list-style: none outside none;\n  margin: 0;\n  text-decoration: none;\n  text-indent: 0;\n  box-shadow: none;\n  flex-grow: 1;\n\n  display: flex;\n  align-items: center;\n  cursor: pointer;\n  color: var(--neutral-base-black);\n\n  padding: 0.3125rem 1rem;\n  gap: 16px;\n\n  span {\n    @include typography.body-three;\n    color: inherit;\n    margin-bottom: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  &:active {\n    border: 0 !important;\n  }\n\n  &:hover {\n    color: var(--neutral-base-black);\n    text-decoration: none;\n    box-shadow: none;\n  }\n}\n\n.unselectableDropdownOption {\n  div {\n    cursor: default !important;\n    span {\n      font-style: italic;\n    }\n  }\n\n  &:hover {\n    background-color: inherit !important;\n  }\n\n  &:active {\n    background-color: inherit !important;\n    span {\n      color: inherit !important;\n    }\n  }\n}\n\n.statusBlob {\n  border-radius: 20px;\n  padding: 0 10px;\n  height: 26px;\n  min-height: 26px;\n  min-width: 82px;\n  max-width: 82px;\n  display: flex;\n  align-items: center;\n}\n\n.greenStatusBlob {\n  background-color: $light_affirmative_100;\n}\n\n.yellowStatusBlob {\n  background-color: $lighter_yellow;\n}\n\n.purpleStatusBlob {\n  background-color: var(--background-brand-purple-light);\n}\n\n.redStatusBlob {\n  background-color: $light_negative_100;\n}\n\n.grayStatusBlob {\n  background-color: $light_gray_100;\n}\n\n.announcementDialog {\n  flex-direction: column;\n  display: flex;\n  align-items: center;\n  text-align: center;\n  max-width: 670px;\n  margin: 12px;\n\n  h2 {\n    margin: 8px 0 20px 0;\n  }\n}\n\n.announcementModal {\n  max-width: 682px !important;\n  max-height: 90% !important;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n@media screen and (max-width: 980px) {\n  .announcementModal {\n    width: 90% !important; /* Set width to 90% of the viewport width */\n  }\n}\n\n.announcementImage {\n  margin-top: 20px;\n  margin-bottom: 20px;\n  max-width: 400px;\n  max-height: 218px;\n  border-radius: 4px;\n}\n\n.announcementBody {\n  max-width: 551px;\n}\n",'@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-barlow-semi-condensed-semibold);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.16;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-barlow-semi-condensed-semibold);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.125rem;\n  line-height: 1.24;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  font-family: var(--font-family-barlow-semi-condensed-semibold);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 1.75rem;\n  line-height: 1.28;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  font-family: var(--font-family-barlow-semi-condensed-semibold);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 1.5rem;\n  line-height: 1.32;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.4;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.48;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.54;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.64;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.04rem;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: 0.813rem;\n  line-height: 1.64;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: 0.688rem;\n  line-height: 1.76;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/custom-icons.min.css';\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n$ai_rubric_cyan: #3cfff8;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n","@use 'variables' as variables;\n@use 'typography.module' as typography;\n@use 'font.scss' as font;\n\n// Typography - Label styles\n@mixin label-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin label-one {\n  @include label-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin label-two {\n  @include label-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin label-three {\n  @include label-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n@mixin label-four {\n  @include label-common;\n  font-size: 0.625rem;\n  line-height: 1.8;\n}\n\n// Typography - Link styles (Link Body styles)\n@mixin link-body-common {\n  @include font.main-font-semi-bold;\n  text-decoration: underline;\n}\n\n@mixin link-body-one {\n  @include link-body-common;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin link-body-two {\n  @include link-body-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin link-body-three {\n  @include link-body-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin link-body-four {\n  @include link-body-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n// Typography Button text styles\n@mixin button-text-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin button-one-text {\n  @include button-text-common;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin button-two-text {\n  @include button-text-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin button-three-text {\n  @include button-text-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin button-four-text {\n  @include button-text-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n// Common field styles\n@mixin field-helper-section-common {\n  display: flex;\n  align-items: baseline;\n  align-self: stretch;\n}\n\n@mixin field-helper-section-l {\n  @include typography.body-two;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-m {\n  @include typography.body-three;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-s {\n  @include typography.body-four;\n  margin-bottom: 0;\n  gap: 0.25rem;\n}\n\n@mixin field-helper-section-black {\n  color: var(--text-neutral-primary);\n}\n\n@mixin field-helper-section-black-disabled {\n  color: var(--text-neutral-disabled);\n}\n\n@mixin field-helper-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-helper-section-white-disabled {\n  color: var(--neutral-gray-70);\n}\n\n@mixin field-error-section-black {\n  color: var(--text-error-primary);\n}\n\n@mixin field-error-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-read-only-black-colors {\n  color: var(--text-neutral-primary);\n  border-color: var(--borders-neutral-disabled);\n  background-color: var(--background-neutral-secondary);\n}\n\n@mixin field-read-only-white-colors {\n  color: var(--text-neutral-inverse);\n  border-color: var(--neutral-gray-70);\n  background-color: var(--neutral-white-alpha-10);\n}\n\n// Focus styles\n@mixin focus-styles {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: 0.125rem;\n}\n\n// Transition styles\n@mixin transition-all {\n  transition: all 0.2s ease;\n}\n\n// Icon styles\n@mixin icon-dimensions($font-size, $line-height: 1.25) {\n  font-size: $font-size;\n  line-height: $line-height;\n  width: calc(#{$font-size} * #{$line-height});\n}\n\n// Border styles\n@mixin border-styles(\n  $border-color: var(--borders-neutral-primary),\n  $border-width: 1px,\n  $border-style: solid,\n  $border-radius: variables.$regular-border-radius\n) {\n  border: $border-width $border-style $border-color;\n  border-radius: $border-radius;\n}\n"],sourceRoot:""}]),a.locals={"heading-xxl":"vdKIv5IKVXV_GbS0H4pP",wrapper:"yofqumXhTsKcaIlIGNHF","heading-xl":"dNnED2yVkk2gFo1X7Bly","heading-lg":"KIVohC1vvyNdN9C83JWH","heading-md":"opnh8Z0_OcGyFlZpBUCA","heading-sm":"CvEhIBhojAeb_Z4eXj2v","heading-xs":"yc50VHTiOocKhFEQS51w","body-one":"G7JSO17n4_DPfkG_HmnO","body-two":"ZYPpppD1fXro3WjewVVT","body-three":"OhWSfX_pAWgQB9Wb5iLn","body-four":"LHX8r4u977WDDApUhFA2","overline-one":"nZq4mEyKRka_pUH1OX13","overline-two":"b7mYM27s7i_tk_EflAw9","overline-three":"IFN_PoXcItjHHkjN9pBA",strong:"diTit74wYKhWqcUa1dTX",em:"yi0trYM99k6iagrL779w",figcaption:"vvHq1S82hcKbcBreuRy6","no-margin":"F_UhbOPnRPyAH9l9ecRO",floatingActionButton:"SG0OeN1BJboN_wKvB1jK",pulse:"QPlALJnn1On05LdueOSH",taOverlay:"GrYL8e_XNezJdKN9bPly",countOverlay:"yhBGpw4hj1QCh1B_6ZLQ",countText:"sWiSwujKzNzpfhxQ2se8",dismissableAlert:"SlssyMsIVfBQbqOTCUN9",dismissableAlertText:"Xqn6gDf_uGgD_5pqHJhp",viewScoresButton:"hU0RnZyjDey8M5Cwc5fa",viewScoresText:"r4fiya2dXTsxS7GRxnco",rubricContainer:"imKW1u60kBnQFcsi9CoA",settings:"mdgadomfjsLFtiYZRzbA",settingsVisible:"STdms8UB4WuohkQbWnK2",settingsHidden:"BbEd9loh1l44eIcWkoWR",aiAssessmentOptions:"DfsWkXKlaM8XSa2WmZZh",rubricContent:"OL59h1mt1ANGUo9QIzXK",visibleRubricContent:"xSUcVizqugJL01f5RqER",hiddenRubricContent:"NrHw7yFPvkAagz5NHs1g",rubricFooter:"t5z6pqYSKSjr2RvrNeGN",rubricFooterContent:"OtsLwybEUX6hbPZsGbY8",submitToStudentButtonAndError:"YpRRfQtvpzmP9nawwdW1",rubricContainerFooter:"EqdA9UdXSckGi9Zfa3Lr",submitToStudentButton:"IGCDN95T5czGCmlvDQug",studentInfo:"g8UD_Vlzc5BvbSuisu6m",studentMetadata:"SHJeJWFEa61OL_PkJ7kl",levelAndStude
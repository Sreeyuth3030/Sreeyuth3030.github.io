use '@cdo/apps/lab2/views/components/layout/variables.scss' as variables;\n@use '@cdo/apps/mixins.scss' as mixins;\n\n.container {\n  display: inline-flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.fileList {\n  padding-top: 0.625rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n}\n\n.buttonContainer {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.actionButton {\n  flex: 1;\n  min-width: 107px; // Triggers wrapping when container is narrow.\n}\n\n.saveAiTutorVersionDescription {\n  padding-top: 0.5rem;\n  padding-bottom: 0.5rem;\n  border-radius: 0 0 variables.$default-border-radius\n    variables.$default-border-radius;\n}\n\n.saveAiTutorVersionDescriptionInput {\n  padding-bottom: 0.5rem;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.textArea {\n  width: 100%;\n  height: 75px;\n  resize: none;\n  box-sizing: border-box;\n  background-color: var(--background-neutral-primary);\n  border: variables.$strong-border;\n  border-radius: variables.$default-border-radius;\n  box-shadow: none;\n  color: var(--text-neutral-secondary);\n  margin-bottom: 0.375rem;\n  padding: 0.625rem;\n\n  &:focus {\n    outline: none;\n    border: variables.$strong-border;\n    box-shadow: none;\n  }\n\n  @include mixins.focus-styles;\n}\n\n.saveAiTutorVersionButton {\n  flex: 1;\n}\n\n.saveAiTutorVersionActions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n","// Removes (most) default button styling. Useful for retaining a clickable component's\n// original presentation when converting it to a <button>\n@mixin remove-button-styles(\n  $color: false,\n  $font-size: false,\n  $line-height: false\n) {\n  @if $color {\n    color: $color;\n  }\n\n  @if $font-size {\n    font-size: $font-size;\n  }\n\n  @if $line-height {\n    line-height: $line-height;\n  }\n\n  margin: 0;\n  padding: 0;\n  border: none;\n  border-radius: 0;\n  background-color: transparent;\n\n  &:hover {\n    box-shadow: none;\n  }\n\n  &:active {\n    border: none !important;\n  }\n}\n\n@mixin icon-button(\n  $default-background-color,\n  $hover-background-color,\n  $selected-color,\n  $active-color\n) {\n  background-color: $default-background-color;\n\n  i {\n    color: var(--text-neutral-tertiary);\n  }\n\n  &.selected i,\n  &:hover i {\n    color: $selected-color;\n  }\n\n  &:hover {\n    background-color: $hover-background-color;\n  }\n\n  &:active i {\n    color: $active-color;\n  }\n}\n\n// Mixin for centering header content with consistent styling\n@mixin center-header-content($include-text-styles) {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 4px;\n  overflow: hidden;\n\n  @if $include-text-styles {\n    &Text {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n  }\n}\n\n// Mixin for applying consistent focus-visible styles\n@mixin focus-styles(\n  $outline-color: var(--borders-brand-teal-primary),\n  $outline-offset: 2px\n) {\n  &:focus-visible {\n    outline: 2px solid $outline-color;\n    outline-offset: $outline-offset;\n  }\n}\n"],sourceRoot:""}]),a.locals={container:"uQ3zVfgNgMVGczsIPVj_",fileList:"skaAjbJHM8Zczqdq3EDg",buttonContainer:"_H3AXQ7Hixton3SKK4ZQ",actionButton:"aABRtZtvDOSgvtlB8ofm",saveAiTutorVersionDescription:"NrPPiav8iHca5lLprA4h",saveAiTutorVersionDescriptionInput:"aH0DiZoADPhDJXCXbkQA",textArea:"TpXmBD5XFjlHSdUsTRxA",saveAiTutorVersionButton:"
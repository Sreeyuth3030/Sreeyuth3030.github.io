"webpack://./src/aichat/views/chatWorkspace.module.scss","webpack://./src/lab2/views/components/layout/variables.scss","webpack://./src/mixins.scss"],names:[],mappings:"AAGA,sBACE,yBAAA,CCIF,sBAEE,WAAA,CACA,YAAA,CACA,qBAAA,CACA,kDAAA,CACA,eAAA,CAGF,sBACE,uBAAA,CAGF,sBACE,8CAAA,CACA,qBAAA,CACA,iBAAA,CAGF,oCACE,mDAAA,CACA,kBAAA,CACA,qBAAA,CAKF,sBACE,iBAAA,CACA,YAAA,CACA,UAAA,CACA,SAAA,CACA,eAAA,CAGF,4CAEE,WAAA,CACA,qBAAA,CACA,eAAA,CAGF,sBACE,iBAAA,CACA,UAAA,CACA,WAAA,CAEA,oCACE,mDAAA,CACA,mBAAA,CACA,qBAAA,CAIJ,sBACE,iBAAA,CACA,mBAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,QAjEgB,CAkEhB,WAAA,CACA,UAAA,CACA,eAAA,CACA,qBAAA,CACA,eAAA,CAGF,sBACE,aAAA,CACA,WAAA,CAGF,sBACE,iBAAA,CACA,UAAA,CACA,YAAA,CACA,sBAAA,CACA,UAAA,CACA,mBAAA,CAGF,sBACE,WAAA,CACA,YAAA,CACA,qBAAA,CACA,kBAAA,CACA,SAAA,CAEA,wBACE,oCAAA,CACA,iBAAA,CAGF,4CACE,cAAA,CAIJ,sBACE,eAAA,CAEA,iEACE,iBAAA,CACA,iBAAA,CAIJ,sBACE,oDAAA,CACA,qBAAA,CAGE,6CACE,eAAA,CAQJ,0BACE,YAAA,CACA,WAAA,CAGF,kCACE,YAAA,CAIJ,sBACE,YAAA,CACA,cAAA,CACA,OAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,SAAA,CACA,eAAA,CACA,mDCtJe,CDuJf,8CAAA,CAEA,4BACE,YAAA,CAIJ,sBACE,YAAA,CACA,cAAA,CACA,UAAA,CACA,sBAAA,CACA,WAAA,CAGF,sBACE,kBAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,wBAAA,CACA,cAAA,CACA,WAAA,CAEA,2CACE,0BAAA,CAIJ,sBACE,eAAA,CACA,iBClLsB,CDmLtB,UAAA,CACA,WAAA,CACA,SAAA,CAEA,2CACE,gBAAA,CAIJ,sBACE,iBC7LsB,CD8LtB,iGAAA,CAGF,sBEvLE,QAAA,CACA,SAAA,CACA,WAAA,CACA,eAAA,CACA,8BAAA,CFqLA,cAAA,CACA,cAAA,CACA,iBCrMsB,CDsMtB,aAAA,CEtLA,4BACE,eAAA,CAGF,6BACE,sBAAA,CAoDF,oCACE,mDAAA,CACA,kBAJe,CFoInB,sBACE,iBAAA,CACA,mBAAA,CACA,cAAA,CAEA,0BAAA,CAEA,+DAEE,0BAAA",sourcesContent:["$border-radius: 4px;\n\n// Rounded bottom border for AI Chat panels\n%panel-section {\n  border-radius: 0 0 $border-radius $border-radius;\n}\n","@use '../../lab2/views/components/layout/variables.scss' as variables;\n@import 'color.scss';\n@import '../../mixins.scss';\n@import './aichat-common.module.scss';\n\n$default-spacing: 16px;\n$tabs-default-spacing: 4px;\n\n.chatWorkspace {\n  @extend %panel-section;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  background-color: var(--background-neutral-primary);\n  overflow: hidden;\n}\n\n.chatMessageOutline {\n  scroll-margin-top: 0.6rem;\n}\n\n.teacherFlaggedMessage {\n  outline: 2px solid var(--borders-error-primary);\n  border-radius: 0.375rem;\n  margin-top: 0.25rem;\n}\n\n.chatMessageOutline:focus-visible {\n  outline: 2px solid var(--borders-brand-teal-primary);\n  outline-offset: 2px;\n  border-radius: 0.375rem;\n}\n\n// We should avoid using this unless necessary for accessibility,\n// as it renders its component out of frame at a size of 1 pixel.\n.accessibilityHidden {\n  position: absolute;\n  left: -9999px;\n  height: 1px;\n  width: 1px;\n  overflow: hidden;\n}\n\n%conversation-area,\n.conversationArea {\n  flex-grow: 1;\n  box-sizing: border-box;\n  overflow-y: auto;\n}\n\n.scrollToBottomContainer {\n  position: relative;\n  width: 100%;\n  height: 100%;\n\n  &:focus-visible {\n    outline: 2px solid var(--borders-brand-teal-primary);\n    outline-offset: -2px;\n    border-radius: 0.375rem;\n  }\n}\n\n.scrollToBottomButton {\n  border-radius: 50%;\n  pointer-events: auto;\n}\n\n.messageArea {\n  display: flex;\n  flex-direction: column;\n  gap: $default-spacing;\n  height: 100%;\n  width: 100%;\n  overflow-y: auto;\n  box-sizing: border-box;\n  padding: 0.625rem;\n}\n\n.instructionsDrawerInset {\n  flex-shrink: 0;\n  height: 18px;\n}\n\n.floatingScrollToBottomButtonContainer {\n  position: absolute;\n  bottom: 5px;\n  display: flex;\n  justify-content: center;\n  width: 100%;\n  pointer-events: none;\n}\n\n.chatDisabledContainer {\n  margin: auto;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.5rem;\n\n  p {\n    color: var(--text-neutral-quaternary);\n    text-align: center;\n  }\n\n  .chatDisabledIcon {\n    font-size: 2rem;\n  }\n}\n\n.chatDisabledAlert {\n  border-radius: 0;\n\n  .chatDisabledAlertIcon.chatDisabledAlertIcon {\n    font-size: 1.25rem;\n    align-self: center;\n  }\n}\n\n.tabsContainer {\n  background-color: var(--background-neutral-secondary);\n  padding: $tabs-default-spacing $tabs-default-spacing 0 $tabs-default-spacing;\n\n  ul {\n    li > button[role='tab'] {\n      max-width: 300px;\n    }\n  }\n}\n\n.tabPanelsContainer {\n  @extend %conversation-area;\n\n  > div {\n    display: flex;\n    height: 100%;\n  }\n\n  > div[hidden] {\n    display: none;\n  }\n}\n\n.buttonRow {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.footer {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  padding: 0.625rem;\n  border-top: variables.$default-border;\n  background: var(--background-neutral-secondary);\n\n  &:empty {\n    display: none;\n  }\n}\n\n.chipsRow {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  align-items: flex-start;\n  min-width: 0;\n}\n\n.alertLink {\n  white-space: nowrap;\n}\n\n.assetCol {\n  display: flex;\n  flex-direction: row;\n  justify-content: flex-end;\n  flex-wrap: wrap;\n  gap: 0.375rem;\n\n  &.assistant {\n    justify-content: flex-start;\n  }\n}\n\n.imagePreview {\n  max-height: 48px;\n  border-radius: variables.$default-border-radius;\n  width: auto;\n  height: auto;\n  opacity: 1;\n\n  &.assistant {\n    max-height: 200px;\n  }\n}\n\n.teacherFlaggedImagePreview {\n  border-radius: variables.$default-border-radius;\n  box-shadow: 0 0 0 2px var(--background-neutral-white-fixed), 0 0 0 4px var(--borders-error-primary);\n}\n\n.assetButton {\n  @include remove-button-styles;\n  align-self: end;\n  font-size: 13px;\n  border-radius: variables.$default-border-radius;\n  line-height: 1;\n\n  @include focus-styles;\n}\n\n.assetImageWrapper {\n  position: relative;\n  display: inline-flex;\n  align-self: end;\n\n  --overflow-menu-opacity: 0;\n\n  &:hover,\n  &:focus-within {\n    --overflow-menu-opacity: 1;\n  }\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n","// Removes (most) default button styling. Useful for retaining a clickable component's\n// original presentation when converting it to a <button>\n@mixin remove-button-styles(\n  $color: false,\n  $font-size: false,\n  $line-height: false\n) {\n  @if $color {\n    color: $color;\n  }\n\n  @if $font-size {\n    font-size: $font-size;\n  }\n\n  @if $line-height {\n    line-height: $line-height;\n  }\n\n  margin: 0;\n  padding: 0;\n  border: none;\n  border-radius: 0;\n  background-color: transparent;\n\n  &:hover {\n    box-shadow: none;\n  }\n\n  &:active {\n    border: none !important;\n  }\n}\n\n@mixin icon-button(\n  $default-background-color,\n  $hover-background-color,\n  $selected-color,\n  $active-color\n) {\n  background-color: $default-background-color;\n\n  i {\n    color: var(--text-neutral-tertiary);\n  }\n\n  &.selected i,\n  &:hover i {\n    color: $selected-color;\n  }\n\n  &:hover {\n    background-color: $hover-background-color;\n  }\n\n  &:active i {\n    color: $active-color;\n  }\n}\n\n// Mixin for centering header content with consistent styling\n@mixin center-header-content($include-text-styles) {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 4px;\n  overflow: hidden;\n\n  @if $include-text-styles {\n    &Text {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n  }\n}\n\n// Mixin for applying consistent focus-visible styles\n@mixin focus-styles(\n  $outline-color: var(--borders-brand-teal-primary),\n  $outline-offset: 2px\n) {\n  &:focus-visible {\n    outline: 2px solid $outline-color;\n    outline-offset: $outline-offset;\n  }\n}\n"],sourceRoot:""}]),a.locals={chatWorkspace:"POhnuRJI0Jln6z9d78iN",chatMessageOutline:"odu4MYfThK1pclhimjT6",teacherFlaggedMessage:"a4S_SCpjG7XDsoRoF7Kf",accessibilityHidden:"sE8V6HutesXA276SmfzT",tabPanelsContainer:"igaz1_l_28rJRLeWK3wQ",conversationArea:"RJggv1ONFBdScqbENPfw",scrollToBottomContainer:"zK7Pc8lmyNzDq7Z5yiQP",scrollToBottomButton:"rSprum2u7TAiDWf2viRa",messageArea:"XWBefh49E95noMOvBbxA",instructionsDrawerInset:"QQxfYOqCqdjD3oQDGqXp",floatingScrollToBottomButtonContainer:"eoJS8Sf8EnNNV7GVQFB5",chatDisabledContainer:"F_6IEJMZFnvjXyLjhHvn",chatDisabledIcon:"zeSLlndA5vWaVkdCF7zu",chatDisabledAlert:"WD98cq4BJuzamDdoHMAG",chatDisabledAlertIcon:"HHDoajZl9MLAx5wFa2k9",tabsContainer:"TQKy4J8R3_Del2eV09sR",buttonRow:"odoiGBLvelTLY5SueVxe",footer:"NClq9awO5fogbcKjzhgX",chipsRow:"p7dwLMFC7g1LZokM4Dxs",alertLink:"Ub17stIX_TZvrVmgjMqX",assetCol:"Rtr8ZVqAmU9siFJTyjqG",assistant:"l7TAFn2IhiKjWJOnyubQ",imagePreview:"ISjvRXNrOG7TeR74kanW",teacherFlaggedImagePreview:"o_baSjQYbepqtu9hxXzz",assetButton:"RrTdWKRR6LtWaaaSdv9M",assetImageWrapper:"h6j6qqMhdTro6ecmCNMz"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(20),o=n.n(r),i=n(21),a=n.n(i)()(o());a.push([e.id,".C9mV1fKwnOXsNJ2ZY310{height:30px;display:flex;align-items:center;gap:.5rem;padding:.25rem .25rem .25rem 40px;border-radius:.25rem;background-color:var(--background-neutral-primary);border:1px solid var(--borders-neutral-strong);position:relative;box-sizing:border-box}.C9mV1fKwnOXsNJ2ZY310 .YzNTV6d7BUq4teZ80Yry{display:flex;align-items:center;gap:.5rem;flex:1;min-width:0}.C9mV1fKwnOXsNJ2ZY310 .rpNv2GECJLyZA3tLc80x{position:absolute;top:-1px;left:-1px;bottom:-1px;width:32px;border-radius:.25rem 0 0 .25rem;display:flex;align-items:center;justify-content:center;border:1px solid rgba(0,0,0,0);border-right:none;box-sizing:border-box}.C9mV1fKwnOXsNJ2ZY310 .rpNv2GECJLyZA3tLc80x i{font-size:14px;color:v
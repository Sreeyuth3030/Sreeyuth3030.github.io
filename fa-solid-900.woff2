A,eAAA,CAIJ,kEACE,kCAAA,CACA,kBAAA,CACA,aAAA,CAKN,sBAEE,SAAA,CACA,6CAAA,CAEA,0BACE,WAjJiB,CAkJjB,UAAA,CACA,iBC9IoB,CDkJxB,sBACE,UAxJmB,CAyJnB,WAzJmB,CA4JrB,sBACE,YAAA",sourcesContent:["@keyframes fade-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n@mixin fade-in($duration: 0.3s) {\n  animation: fade-in $duration;\n}\n","@use '@cdo/apps/lab2/views/components/layout/variables.scss' as variables;\n@import '../../../mixins.scss';\n@import '../mixins.scss';\n\n$preview-image-size: 32px;\n\n.container {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n}\n\n.row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  padding-top: 0.125rem;\n  min-width: 0;\n}\n\n%preview {\n  border-radius: variables.$default-border-radius;\n  position: relative;\n}\n\n.topRightIcon {\n  @include remove-button-styles;\n  z-index: 1;\n  font-size: 16px;\n  position: absolute;\n  right: -8px;\n  top: -8px;\n  color: var(--text-neutral-quaternary);\n  transition: opacity 0.2s ease, color 0.2s ease;\n\n  i {\n    background-color: var(--background-neutral-primary);\n    border-radius: 100%;\n  }\n\n  &Close {\n    color: var(--text-neutral-primary);\n    &:hover {\n      color: var(--text-error-primary);\n    }\n  }\n}\n\n.closeTooltipOverlay {\n  position: absolute;\n  top: 0;\n  right: 0;\n}\n\n.closeTooltip {\n  @include fade-in(0.3s);\n}\n\n.preview-file {\n  @extend %preview;\n  display: flex;\n  gap: 0;\n  text-align: left;\n  align-items: center;\n  min-width: 0;\n  max-width: 100%;\n\n  .fileIcon {\n    display: flex;\n    width: $preview-image-size;\n    height: $preview-image-size;\n    border-radius: variables.$default-border-radius 0 0\n      variables.$default-border-radius;\n    background-color: var(--background-brand-teal-primary);\n\n    html[dir='rtl'] & {\n      border-radius: 0 variables.$default-border-radius\n        variables.$default-border-radius 0;\n    }\n\n    i {\n      margin: auto;\n      font-size: 13px;\n      color: var(--text-neutral-white-fixed);\n    }\n  }\n\n  .filenameContainer {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-evenly;\n    flex: 1;\n    min-width: 0;\n    height: 32px;\n    box-sizing: border-box;\n    color: var(--text-neutral-primary);\n    background: var(--background-neutral-primary);\n    padding: 0 0.5rem;\n    border: variables.$default-border;\n    border-inline-start: 0;\n    border-radius: 0 variables.$default-border-radius\n      variables.$default-border-radius 0;\n    line-height: 1;\n    text-align: initial;\n\n    html[dir='rtl'] & {\n      border-radius: variables.$default-border-radius 0 0\n        variables.$default-border-radius;\n    }\n\n    strong,\n    span {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .filenameRow {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      overflow: hidden;\n\n      .filenameText {\n        flex-shrink: 1;\n        min-width: 0;\n        overflow: hidden;\n        text-overflow: ellipsis;\n        white-space: nowrap;\n        margin: 0;\n        font-weight: 600;\n      }\n    }\n\n    .timestamp {\n      color: var(--text-neutral-tertiary);\n      white-space: nowrap;\n      flex-shrink: 0;\n    }\n  }\n}\n\n.preview-image {\n  @extend %preview;\n  padding: 0;\n  background: var(--background-neutral-tertiary);\n\n  img {\n    height: $preview-image-size;\n    width: auto;\n    border-radius: variables.$default-border-radius;\n  }\n}\n\n.preview-image-loading {\n  width: $preview-image-size;\n  height: $preview-image-size;\n}\n\n.hide {\n  display: none;\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n","// Removes (most) default button styling. Useful for retaining a clickable component's\n// original presentation when converting it to a <button>\n@mixin remove-button-styles(\n  $color: false,\n  $font-size: false,\n  $line-height: false\n) {\n  @if $color {\n    color: $color;\n  }\n\n  @if $font-size {\n    font-size: $font-size;\n  }\n\n  @if $line-height {\n    line-height: $line-height;\n  }\n\n  margin: 0;\n  padding: 0;\n  border: none;\n  border-radius: 0;\n  background-color: transparent;\n\n  &:hover {\n    box-shadow: none;\n  }\n\n  &:active {\n    border: none !important;\n  }\n}\n\n@mixin icon-button(\n  $default-background-color,\n  $hover-background-color,\n  $selected-color,\n  $active-color\n) {\n  background-color: $default-background-color;\n\n  i {\n    color: var(--text-neutral-tertiary);\n  }\n\n  &.selected i,\n  &:hover i {\n    color: $selected-color;\n  }\n\n  &:hover {\n    background-color: $hover-background-color;\n  }\n\n  &:active i {\n    color: $active-color;\n  }\n}\n\n// Mixin for centering header content with consistent styling\n@mixin center-header-content($include-text-styles) {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 4px;\n  overflow: hidden;\n\n  @if $include-text-styles {\n    &Text {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n  }\n}\n\n// Mixin for applying consistent focus-visible styles\n@mixin focus-styles(\n  $outline-color: var(--borders-brand-teal-primary),\n  $outline-offset: 2px\n) {\n  &:focus-visible {\n    outline: 2px solid $outline-color;\n    outline-offset: $outline-offset;\n  }\n}\n"],sourceRoot:""}]),a.locals={container:"u8ef4zLB71IH_aAiF3hx",row:"ZgI3OrDurfoNHTGI
ute;\n    top: -1px;\n    left: -1px;\n    bottom: -1px;\n    width: 32px;\n    border-radius: 0.25rem 0 0 0.25rem;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid transparent;\n    border-right: none;\n    box-sizing: border-box;\n    i {\n      font-size: 14px;\n      color: var(--text-neutral-white-fixed);\n    }\n  }\n\n  .fileName {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .previewButtonWrapper {\n    margin-left: auto;\n    flex-shrink: 0;\n  }\n}\n\n.newFile {\n  .statusIndicator {\n    background-color: var(--background-success-primary);\n    border-color: var(--background-success-primary);\n  }\n}\n\n.updatedFile {\n  .statusIndicator {\n    background-color: var(--background-neutral-senary);\n    border-color: var(--background-neutral-senary);\n  }\n}\n\n.acceptedIcon {\n  margin-left: auto;\n  margin-right: 0.25rem;\n  color: var(--text-success-primary);\n}\n\n.rejectedIcon {\n  margin-left: auto;\n  margin-right: 0.25rem;\n  color: var(--text-error-primary);\n}\n","// Shared variables across Lab2\n\n// Default border style\n$default-border: 1px solid var(--borders-neutral-primary);\n\n// Strong border style\n$strong-border: 1px solid var(--borders-neutral-strong);\n\n// Border radius\n$default-border-radius: 4px;\n\n/** z-indices */\n\n// UI elements that float above main content but below overlays\n$z-index-floating-ui: 60;\n// Full screen overlays (e.g. loading screen)\n$z-index-overlay: 72;\n// Full screen overlays that need to be above everything else\n// (e.g. file preview in full screen) — got value from MUI\n$z-index-fullscreen: 1300;\n"],sourceRoot:""}]),a.locals={chip:"C9mV1fKwnOXsNJ2ZY310",fileInfo:"YzNTV6d7BUq4teZ80Yry",statusIndicator:"rpNv2GECJLyZA3tLc80x",fileName:"DZOcH6FOBFXn4MBAUpF_",previewButtonWrapper:"JfL3s8gbFrLoAZvlmMCN",newFile:"LraXbOZ5o6PlHujFoCiA",updatedFile:"ht7czXOA4HuTt3913kgt",acceptedIcon:"wWijR929iwHI23ByBTE3",rejectedIcon:
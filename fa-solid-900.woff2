AA,CACA,iBAAA,CACA,+CAAA,CAEA,sBACE,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,WAAA,CACA,qDAAA,CACA,0BAAA,CACA,2BAAA,CACA,cAAA,CAEA,4CACE,cAAA,CACA,eAAA,CACA,kBAAA,CAMJ,6BACE,WAAA,CACA,+BACE,wCAAA,CAMN,sBACE,UAAA,CACA,cAAA,CACA,WAAA,CACA,QAAA,CACA,qBAAA,CACA,cAAA,CACA,eAAA,CACA,sDAAA,CAEA,4CACE,uCAAA,CAGF,4CACE,uCAAA,CAGF,4CACE,oCAAA,CAGF,4CACE,4CAAA,CAGF,4CACE,qCAAA,CAGF,4CACE,uCAAA,CAKF,yDACE,WAAA,CACA,6BAAA,CACA,8BAAA",sourcesContent:[".ai-tutor-sidebar {\n  width: 45px;\n  position: absolute;\n  right: 0;\n  top: 0;\n  border-radius: 4px;\n  border: 1px solid var(--borders-neutral-primary);\n\n  &-header {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 8px;\n    background-color: var(--background-brand-aqua-primary);\n    border-top-left-radius: 4px;\n    border-top-right-radius: 4px;\n    cursor: pointer;\n\n    .bot-icon {\n      width: 1.875rem;\n      height: 1.875rem;\n      object-fit: contain;\n    }\n  }\n}\n\n.ai-tutor-sidebar-content {\n  > button {\n    height: 30px;\n    i {\n      color: var(--background-neutral-octonary);\n    }\n  }\n}\n\n// AiTutorSidebarSuggestedPrompts styles\n.ai-tutor-suggested-prompt-item {\n  width: 45px;\n  min-width: 45px;\n  height: 45px;\n  margin: 0;\n  background-color: white;\n  cursor: pointer;\n  border-radius: 0;\n  border-bottom: 1px solid var(--borders-neutral-primary);\n\n  .icon-code {\n    color: var(--text-success-primary-fixed);\n  }\n\n  .icon-lightbulb {\n    color: var(--text-warning-primary-fixed);\n  }\n\n  .icon-book {\n    color: var(--text-info-primary-fixed);\n  }\n\n  .icon-brain {\n    color: var(--text-brand-purple-primary-fixed);\n  }\n\n  .icon-bug {\n    color: var(--text-error-primary-fixed);\n  }\n\n  .icon-star {\n    color: var(--text-warning-primary-fixed);\n  }\n}\n\n.ai-tutor-suggested-prompts-list {\n  .ai-tutor-suggested-prompt-item:last-of-type {\n    border: none;\n    border-bottom-left-radius: 4px;\n    border-bottom-right-radius: 4px;\n  }\n}\n"],